{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "paths": {
      "~/src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.mjs", "tests"],
  "exclude": ["src/dist"]
}
