    "@vitest/eslint-plugin": "1.3.4",
    "eslint": "9.31.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.3.0",
    "msw": "2.10.4",
    "prettier": "3.6.2",
    "rollup": "4.45.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "3.2.4"
  }
}
